# Copia este archivo como .env y completa con tus credenciales
# (NUNCA subas .env a git — ya esta en .gitignore)

# --- Fitbit (dev.fitbit.com) ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:5174/callback/fitbit

# --- Whoop (developer.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:5174/callback/whoop

# --- Google Fit / Health (Google Cloud Console, cliente tipo "web") ---
# NOTA: Google Fit REST API esta en proceso de cierre/migracion a Health
# Connect (solo Android). Este proveedor es best-effort: requiere habilitar
# "Fitness API" en el proyecto y que la API siga activa. Si Google la apaga,
# /api/google/daily devolvera 0 dias o 4xx.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bio-pulse-six.vercel.app/callback/google

# --- Coach IA (Google Gemini) ---
# Clave desde https://aistudio.google.com/apikey (gratis, free tier generoso)
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Origen permitido para CORS (solo tu frontend). Cambia por tu dominio real.
ALLOWED_ORIGIN=https://bio-pulse-six.vercel.app

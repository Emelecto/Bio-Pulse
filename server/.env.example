# Copia este archivo como .env y completa con tus credenciales
# (NUNCA subas .env a git — ya esta en .gitignore)

# --- Fitbit (dev.fitbit.com) ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:5174/callback/fitbit

# --- Whoop (developer.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:5174/callback/whoop

# Puerto del proxy
PORT=4000
